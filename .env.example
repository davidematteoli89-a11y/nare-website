# MeLoProduco Website — variabili d'ambiente (Step 1U)
#
# Solo config pubblica + le env private strettamente necessarie (Brevo,
# Fase 8). NESSUN secret/credenziale Supabase/aiDady qui: il sito non ha e
# non deve mai avere accesso a Supabase privato o a qualunque credenziale
# interna aiDady.

# Base URL delle API pubbliche aiDady (fallback hardcoded nel codice se assente).
AIDADY_PUBLIC_API_BASE_URL=https://aidady-business-os.vercel.app

# URL pubblico di questo sito (usato per metadataBase, Open Graph, sitemap.xml, robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Brevo (Fase 8, Step 8C/8D) ---------------------------------------
# Tutte private (server-only, MAI NEXT_PUBLIC_*): usate solo in
# lib/brevo.ts, importato esclusivamente da Server Action
# (lib/newsletter-actions.ts), mai in codice client. Solo nomi qui sotto,
# nessun valore/secret committato.

# API key Brevo — server-side only.
BREVO_API_KEY=

# ID numerico della lista Brevo "Newsletter Narè" (Step 8E: una sola lista).
BREVO_NEWSLETTER_LIST_ID=

# ID del template Brevo per l'email di conferma double opt-in
# (Step 8G — Campagne > Template in Brevo).
BREVO_DOUBLE_OPTIN_TEMPLATE_ID=
